# ============================================================
# CoinJecko / Finance Hub — environment template
# Copy to .env.local and fill in real values.
# NEVER commit real secrets. .env* files are git-ignored;
# only this .env.example is tracked.
# ============================================================

# --- Site -----------------------------------------------------
# Public canonical origin (no trailing slash). Used for SEO
# canonicals, hreflang, sitemaps and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (managed PostgreSQL + auth) --------------------
# Public values — safe to expose to the browser (anon key is
# protected by Row-Level Security, never by secrecy).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row-Level Security. Must never reach
# the client bundle, HTML source or browser network requests.
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data providers (server-side proxy only) ----------
# All third-party market data is fetched through server-side
# API routes. Keys must never be referenced with NEXT_PUBLIC_.
MARKET_DATA_API_KEY=
# CoinGecko. Optional for local development, but REQUIRED in any
# cloud deployment: the keyless public API blocks datacenter address
# ranges and answers 404, so crypto prices silently go dark on Vercel
# while working fine from a laptop. A free Demo key fixes it —
# https://www.coingecko.com/en/developers/dashboard — and is sent as
# the x-cg-demo-api-key header, never exposed to the browser.
CRYPTO_DATA_API_KEY=
FOREX_DATA_API_KEY=
ECONOMIC_CALENDAR_API_KEY=
# Crude-oil benchmarks (Brent, WTI) come from the U.S. Energy
# Information Administration, which needs a free key from
# https://www.eia.gov/opendata/register.php — without it the two oil
# cards stay gated. Gold and silver need no key.
COMMODITY_DATA_API_KEY=

# --- Rate limiting / cache (optional, recommended in prod) ---
# When unset, an in-memory per-instance limiter is used
# (adequate for development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monetisation (optional) ---------------------------------
# AdSense publisher id, e.g. ca-pub-1234567890123456. Public by
# design (it ships inside the ad tag). While unset, every ad slot
# renders nothing rather than an empty placeholder box.
# NOTE: enabling AdSense also requires adding googlesyndication /
# doubleclick origins to script-src, img-src and frame-src in
# src/lib/security/headers.ts.
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Observability (optional) --------------------------------
SENTRY_DSN=

# --- Runtime -------------------------------------------------
# development | production | test  (set automatically by Next)
# NODE_ENV=

# --- Public contact details ----------------------------------
# Published contact channels, not secrets. Anything left unset is
# simply not rendered — a wrong address is worse than none.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Social profiles must be absolute https URLs or they are ignored.
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
